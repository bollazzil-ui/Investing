# Template for local API keys.
#
#   cp .env.example .env.local
#
# then fill in .env.local. That file is git-ignored, so your keys stay on your
# machine. Restart `npm run dev` after changing it.
#
# The keys are used only by the dev server's proxy and are never sent to the
# browser. Do not rename them with a VITE_ prefix — that would bundle them into
# the client code.

# Stooq share prices. Free key (solve the CAPTCHA):
#   https://stooq.com/q/d/?s=spy.us&get_apikey
STOOQ_API_KEY=

# OpenFIGI instrument lookup (optional — works without a key, ~25 lookups/min).
# Free key: https://www.openfigi.com/api
OPENFIGI_API_KEY=
